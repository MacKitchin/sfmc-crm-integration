    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Matching_Contact</targetReference>
        </connector>
        <filterFormula>OR(BEGINS(TEXT({!$Record.LeadSource}), &quot;MC &quot;), {!$Record.CreatedById} = &quot;0054X00000Dk173QAB&quot;)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
